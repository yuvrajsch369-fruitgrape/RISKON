# RISKON environment configuration — copy this file to `.env` and fill in
# the values you have. Every variable below has a safe default if omitted
# (see backend/config.py); the ONLY one you need to touch to enable real AI
# features is ANTHROPIC_API_KEY.
#
#   cp .env.example .env
#   # paste your key below
#   uvicorn backend.main:app --reload --port 8743
#
# Never commit the real `.env` file — see .gitignore.

# --- AI provider switch -------------------------------------------------------
# Which service answers POST /api/incidents/{id}/analyze: "claude" or
# "nvidia_nim". Defaults to "claude". Set to "nvidia_nim" (and fill in
# NVIDIA_API_KEY below) to run RISKON V0 on NVIDIA's free NIM tier instead of
# paying per-call for Claude -- flip this back to "claude" once a real
# deployment needs Claude's reliability. No code changes either way.
AI_PROVIDER=claude

# --- Claude / Anthropic (used when AI_PROVIDER=claude) ------------------------
# Get a key at https://console.anthropic.com/ . Leave blank to run RISKON
# with AI features disabled (every other page/feature still works).
ANTHROPIC_API_KEY=

# The exact Claude model RISKON's backend calls. Centralized here so it can
# be changed in one place, without touching any application code.
ANTHROPIC_MODEL=claude-sonnet-5

# How long the backend waits for one Claude API response before giving up.
ANTHROPIC_TIMEOUT_SECONDS=30

# Max tokens requested per AI analysis response.
ANTHROPIC_MAX_TOKENS=1536

# --- NVIDIA NIM (used when AI_PROVIDER=nvidia_nim) -----------------------------
# Free, no credit card -- sign up at https://build.nvidia.com/ , open any
# model in the catalog, and click "Get API Key" (starts with nvapi-, valid
# 6 months). NVIDIA labels this an evaluation tier, not for production
# traffic -- fine for V0 testing, not the long-term home for a real pilot.
#
# Measured against a real incident: Nemotron Ultra is a reasoning model that
# spends a large token budget on internal chain-of-thought before the final
# JSON answer, and this free endpoint is slow -- one real analysis took
# ~140 seconds. The timeout/max_tokens below are what an actual successful
# call needed; don't lower them without re-testing against a real incident.
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_TIMEOUT_SECONDS=150
NVIDIA_NIM_MAX_TOKENS=8192

# --- Database -----------------------------------------------------------------
# The existing SQLite database already used by every script in this repo.
# Only change this if you've moved/renamed database/riskon.db.
DATABASE_PATH=./database/riskon.db

# --- Server ---------------------------------------------------------------------
RISKON_HOST=0.0.0.0
RISKON_PORT=8743

# Comma-separated list of allowed origins for the API, or `*` for any (fine
# for local/PoC use since the backend also serves the frontend itself on the
# same origin).
CORS_ORIGINS=*

# --- Misc -------------------------------------------------------------------------
LOG_LEVEL=INFO
RISKON_ENV=development
