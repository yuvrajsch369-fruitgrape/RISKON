# RISKON environment configuration — copy this file to `.env` and fill in
# the values you have. Every variable below has a safe default if omitted
# (see backend/config.py); the ONLY one you need to touch to enable real AI
# features is ANTHROPIC_API_KEY.
#
#   cp .env.example .env
#   # paste your key below
#   uvicorn backend.main:app --reload --port 8743
#
# Never commit the real `.env` file — see .gitignore.

# --- Claude / Anthropic (required for AI features) --------------------------
# Get a key at https://console.anthropic.com/ . Leave blank to run RISKON
# with AI features disabled (every other page/feature still works).
ANTHROPIC_API_KEY=

# The exact Claude model RISKON's backend calls. Centralized here so it can
# be changed in one place, without touching any application code.
ANTHROPIC_MODEL=claude-sonnet-5

# How long the backend waits for one Claude API response before giving up.
ANTHROPIC_TIMEOUT_SECONDS=30

# Max tokens requested per AI analysis response.
ANTHROPIC_MAX_TOKENS=1536

# --- Database -----------------------------------------------------------------
# The existing SQLite database already used by every script in this repo.
# Only change this if you've moved/renamed database/riskon.db.
DATABASE_PATH=./database/riskon.db

# --- Server ---------------------------------------------------------------------
RISKON_HOST=0.0.0.0
RISKON_PORT=8743

# Comma-separated list of allowed origins for the API, or `*` for any (fine
# for local/PoC use since the backend also serves the frontend itself on the
# same origin).
CORS_ORIGINS=*

# --- Misc -------------------------------------------------------------------------
LOG_LEVEL=INFO
RISKON_ENV=development
